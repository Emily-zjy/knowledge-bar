APP_ENV=local
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# openai_compatible works for OpenAI-compatible providers.
# anthropic works for Anthropic Claude Messages API.
# mock returns a local fallback mind map.
AI_PROVIDER=openai_compatible
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=45
AI_PROMPT_VERSION=p0-2026-07-29
AI_MOCK_FALLBACK=true

# Optional for validating Supabase Auth JWTs in FastAPI.
SUPABASE_JWT_SECRET=
