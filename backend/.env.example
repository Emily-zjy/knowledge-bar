APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000

# Comma-separated allowed origins. Empty = localhost defaults in local, deny-all in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# openai_compatible works for OpenAI-compatible providers (including proxies like rightapi.ai).
# anthropic works for Anthropic Claude Messages API (supports custom base URL via AI_BASE_URL).
# mock returns a local fallback mind map (BLOCKED in production).
AI_PROVIDER=openai_compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
AI_JSON_RETRIES=1
AI_RETRY_BASE_SECONDS=0.75
AI_RETRY_MAX_SECONDS=8
AI_RETRY_JITTER_SECONDS=0.35
# Prompt version: v1 (original), v2 (precision-optimized), or p0-mindmap-v1 (legacy alias for v1)
AI_PROMPT_VERSION=v1
# Rollout: stable-hash traffic splitting for gradual V2 deployment.
# AI_PROMPT_V2_PERCENTAGE=0..100 (0=all V1, 100=all V2, 10=10% V2)
AI_PROMPT_V2_PERCENTAGE=0
# Fallback version when not assigned to V2 bucket
AI_PROMPT_FALLBACK_VERSION=v1
# Rollout mode (stable_hash is the only supported mode)
AI_PROMPT_ROLLOUT_MODE=stable_hash
# IMPORTANT: AI_MOCK_FALLBACK must be false in production (APP_ENV=production).
# The application will refuse AI requests if this is true in production.
AI_MOCK_FALLBACK=false
# Explicit rollout switches. Apply/verify migration before enabling either in Production.
AI_QUEUE_ENABLED=false
AI_WORKER_ENABLED=false
# Set AI_MAX_CONCURRENCY only from the approved live benchmark boundary.
AI_MAX_CONCURRENCY=5
AI_MAX_ACTIVE_JOBS_PER_USER=1
AI_MAX_QUEUE_SIZE=100
AI_WORKER_POLL_SECONDS=1.5
AI_JOB_TIMEOUT_SECONDS=210
AI_JOB_LEASE_SECONDS=270
AI_JOB_HEARTBEAT_SECONDS=30

# Supabase configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Deprecated compatibility — use SUPABASE_PUBLISHABLE_KEY and SUPABASE_SECRET_KEY instead:
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# DEPRECATED: SUPABASE_JWT_SECRET is NOT used for authentication.
# All token verification goes through Supabase Auth API (GET /auth/v1/user).
# This field is retained only for reference and will be removed in a future version.
# SUPABASE_JWT_SECRET=

# Content limits (bytes)
MAX_CONTENT_LENGTH=120000
MAX_EXPORT_LENGTH=5000000
