APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# openai_compatible works for OpenAI-compatible providers.
# anthropic works for Anthropic Claude Messages API.
# mock returns a local fallback mind map.
AI_PROVIDER=openai_compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=1
AI_PROMPT_VERSION=p0-2026-07-29
AI_MOCK_FALLBACK=false

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
